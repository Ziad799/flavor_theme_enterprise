<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tfe_font_link" model="ir.ui.view">
        <field name="name">theme_flavor.font_link</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="web.layout"/>
        <field name="arch" type="xml">
            <xpath expr="//head/meta[1]" position="before">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
            </xpath>
        </field>
    </record>
</odoo>
