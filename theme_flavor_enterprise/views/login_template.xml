<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tfe_login_layout" model="ir.ui.view">
        <field name="name">tfe.login.layout</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="web.login_layout"/>
        <field name="arch" type="xml">
            <!-- Change body class -->
            <xpath expr="//t[@t-set='body_classname']" position="attributes">
                <attribute name="t-value">'tfe-login-page'</attribute>
            </xpath>
            <!-- Remove bg-100 from card -->
            <xpath expr="//div[contains(@t-attf-class, 'bg-100')]" position="attributes">
                <attribute name="t-attf-class">card border-0 mx-auto tfe-glass-card {{login_card_classes}} o_database_list</attribute>
                <attribute name="style"/>
            </xpath>
            <!-- Background: custom image OR SVG landscape -->
            <xpath expr="//div[hasclass('container')]" position="before">
                <t t-set="tfe_company" t-value="request.env['res.company'].sudo().browse(request.env.company.id)"/>
                <t t-if="tfe_company.tfe_login_bg">
                    <!-- Custom uploaded background image -->
                    <div t-attf-style="position:fixed;inset:0;z-index:0;background:url('/web/image/res.company/#{tfe_company.id}/tfe_login_bg') center/cover no-repeat;">
                        <div style="position:absolute;inset:0;background:rgba(40,33,80,0.45);"/>
                    </div>
                </t>
                <t t-else="">
                    <!-- Default SVG Mountain Landscape -->
                    <svg viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice"
                         style="position:fixed;inset:0;width:100%;height:100%;z-index:0;display:block;">
                        <defs>
                            <linearGradient id="tfe-sky" x1="0" y1="0" x2="0.35" y2="1">
                                <stop offset="0%" stop-color="#243046"/>
                                <stop offset="45%" stop-color="#4a3f7a"/>
                                <stop offset="100%" stop-color="#6f6b9c"/>
                            </linearGradient>
                            <linearGradient id="tfe-water" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#5a5888" stop-opacity=".6"/>
                                <stop offset="100%" stop-color="#4a4870" stop-opacity=".9"/>
                            </linearGradient>
                        </defs>
                        <rect x="0" y="0" width="1200" height="620" fill="url(#tfe-sky)"/>
                        <circle cx="70" cy="40" r="1.6" fill="#cdd0e6" opacity=".9"/>
                        <circle cx="150" cy="80" r="1.2" fill="#cdd0e6" opacity=".6"/>
                        <circle cx="230" cy="35" r="1.4" fill="#cdd0e6" opacity=".8"/>
                        <circle cx="500" cy="50" r="1.3" fill="#cdd0e6" opacity=".7"/>
                        <circle cx="750" cy="70" r="1.5" fill="#c3c8e3" opacity=".8"/>
                        <circle cx="900" cy="45" r="1.2" fill="#cdd0e6" opacity=".6"/>
                        <circle cx="1050" cy="60" r="1.4" fill="#cdd0e6" opacity=".7"/>
                        <circle cx="920" cy="110" r="28" fill="#f4f2fb" opacity=".18"/>
                        <circle cx="920" cy="110" r="22" fill="#f4f2fb" opacity=".1"/>
                        <path d="M0,420 L80,340 L160,390 L260,300 L360,360 L440,280 L520,350 L600,290 L700,360 L800,300 L880,350 L960,280 L1040,340 L1120,300 L1200,360 L1200,620 L0,620 Z" fill="#4a4870" opacity=".7"/>
                        <path d="M0,460 L100,380 L200,430 L320,350 L420,410 L520,340 L640,400 L740,340 L840,390 L960,330 L1060,380 L1200,320 L1200,620 L0,620 Z" fill="#3d3860" opacity=".8"/>
                        <path d="M0,500 L120,440 L240,480 L380,410 L480,460 L600,400 L720,450 L840,400 L960,440 L1080,390 L1200,430 L1200,620 L0,620 Z" fill="#332e55" opacity=".9"/>
                        <rect x="0" y="500" width="1200" height="120" fill="url(#tfe-water)"/>
                        <line x1="100" y1="530" x2="200" y2="530" stroke="#9aa1c8" stroke-width=".5" opacity=".15"/>
                        <line x1="400" y1="550" x2="550" y2="550" stroke="#a9b0d4" stroke-width=".4" opacity=".12"/>
                        <line x1="700" y1="540" x2="830" y2="540" stroke="#9aa1c8" stroke-width=".5" opacity=".1"/>
                    </svg>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
